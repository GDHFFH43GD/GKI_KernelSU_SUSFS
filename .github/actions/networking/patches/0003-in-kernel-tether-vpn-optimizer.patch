+static void ip_forward_clamp_mss(struct sk_buff *skb)
+{
+	struct iphdr *iph;
+	struct tcphdr *th;
+	unsigned int thoff;
+	int optlen;
+	u8 *opt;
+
+	if (!skb || skb->protocol != htons(ETH_P_IP))
+		return;
+
+	iph = ip_hdr(skb);
+	if (!iph || iph->protocol != IPPROTO_TCP)
+		return;
+
+	thoff = iph->ihl * 4;
+	if (!pskb_may_pull(skb, thoff + sizeof(struct tcphdr)))
+		return;
+
+	iph = ip_hdr(skb);
+	th = (struct tcphdr *)((u8 *)iph + thoff);
+	if (!th->syn)
+		return;
+
+	optlen = (th->doff * 4) - sizeof(struct tcphdr);
+	if (optlen <= 0 || !pskb_may_pull(skb, thoff + (th->doff * 4)))
+		return;
+
+	iph = ip_hdr(skb);
+	th = (struct tcphdr *)((u8 *)iph + thoff);
+	opt = (u8 *)(th + 1);
+
+	while (optlen > 0) {
+		int opcode = *opt++;
+		int opsize;
+
+		if (opcode == 0)
+			break;
+		if (opcode == 1) {
+			optlen--;
+			continue;
+		}
+		if (optlen < 2)
+			break;
+		opsize = *opt++;
+		if (opsize < 2 || opsize > optlen)
+			break;
+		if (opcode == 2 && opsize == 4) {
+			__be16 *mssp = (__be16 *)opt;
+			if (ntohs(*mssp) > 1380) {
+				__be16 new_mss = htons(1380);
+				inet_proto_csum_replace2(&th->check, skb, *mssp, new_mss, false);
+				*mssp = new_mss;
+			}
+			break;
+		}
+		opt += opsize - 2;
+		optlen -= opsize;
+	}
+}
