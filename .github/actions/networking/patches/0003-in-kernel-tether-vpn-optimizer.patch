+static struct net_device *find_active_vpn_dev_rcu(struct net *net)
+{
+	struct net_device *dev;
+
+	for_each_netdev_rcu(net, dev) {
+		if ((dev->flags & (IFF_UP | IFF_RUNNING)) == (IFF_UP | IFF_RUNNING) &&
+		    is_vpn_dev_name(dev->name))
			return dev;
+	}
+	return NULL;
+}
